{
  "name": "netent-game-developer-test",
  "version": "1.0.0",
  "description": "NetEnt - Game Developer Test",
  "scripts": {
    "start": "concurrently --kill-others \"npm run build:server:watch\" \"npm run build:client:watch\"",
    "build:server:watch": "nodemon -e ts --watch src/server --exec \"tsc -p src/server/tsconfig.json && node dist/server/server.js\"",
    "build:client:watch": "parcel ./src/client/index.html ./public/**/*",
    "test": "jest --passWithNoTests",
    "cy:open": "cypress open",
    "cy:test": "cy:open & cypress run"
  },
  "dependencies": {
    "cypress": "6.8.0",
    "express": "^4.16.2",
    "gsap": "^3.11.4",
    "pixi.js": "^7.0.5"
  },
  "devDependencies": {
    "@parcel/transformer-xml": "^2.8.2",
    "@types/cors": "^2.8.12",
    "@types/express": "4.17.13",
    "@types/gsap": "^3.0.0",
    "@types/jest": "26.0.22",
    "@types/node": "14.17.18",
    "concurrently": "^7.3.0",
    "cors": "^2.8.5",
    "jest": "26.6.0",
    "nodemon": "2.0.13",
    "parcel": "^2.7.0",
    "prettier": "^2.8.1",
    "punycode": "^1.4.1",
    "querystring-es3": "^0.2.1",
    "ts-jest": "26.5.4",
    "typescript": "4.4.3"
  }
}
